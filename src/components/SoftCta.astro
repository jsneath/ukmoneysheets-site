---
const etsyUrl = 'https://www.etsy.com/shop/UkMoneySheets';
const { heading = 'Prefer a ready-made Google Sheet?' } = Astro.props;
---

<aside class="soft-cta" aria-label="Shop call to action">
  <p><strong>{heading}</strong></p>
  <p>
    UkMoneySheets sells UK-ready templates on Etsy — Google Sheets (not Excel), GBP-friendly categories,
    and instant download. Browse the shop if a guide here matches something you want to track.
  </p>
  <p>
    <a class="btn btn-primary" href={etsyUrl} rel="noopener noreferrer" target="_blank">Visit the Etsy shop</a>
  </p>
</aside>
