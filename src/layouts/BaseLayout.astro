---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = Astro.url.pathname } = Astro.props;
const siteName = 'UkMoneySheets';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const etsyUrl = 'https://www.etsy.com/shop/UkMoneySheets';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">£</span>
          <span>UkMoneySheets</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a href="/" class={Astro.url.pathname === '/' ? 'is-active' : undefined}>Home</a>
          <a href="/guides/" class={Astro.url.pathname.startsWith('/guides') ? 'is-active' : undefined}>Guides</a>
          <a class="btn btn-on-dark" href={etsyUrl} rel="noopener noreferrer" target="_blank">Shop on Etsy</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <h2>UkMoneySheets</h2>
          <p>
            Simple, honest <strong>Google Sheets</strong> templates for UK personal finance —
            budgets, tax records, savings, and more. Instant download from our
            <a href={etsyUrl} rel="noopener noreferrer" target="_blank">Etsy shop</a>.
          </p>
          <p class="disclaimer">
            <strong>Not tax, financial, or mortgage advice.</strong> These guides and templates are
            general information only. Rules change. Always check live guidance on
            <a href="https://www.gov.uk" rel="noopener noreferrer" target="_blank">GOV.UK</a>
            and impartial help from
            <a href="https://www.moneyhelper.org.uk/en" rel="noopener noreferrer" target="_blank">MoneyHelper</a>,
            or speak to a qualified adviser before you act.
          </p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href={etsyUrl} rel="noopener noreferrer" target="_blank">Etsy shop</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
