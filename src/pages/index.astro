---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoftCta from '../components/SoftCta.astro';

const guides = (await getCollection('guides')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en-GB')
);
const etsyUrl = 'https://www.etsy.com/shop/UkMoneySheets';
const description =
  'UkMoneySheets publishes calm UK money guides and sells Google Sheets templates for British budgets, tax records, and savings — shop on Etsy.';
---

<BaseLayout title="UkMoneySheets" description={description} canonicalPath="/">
  <section class="hero">
    <div class="hero-inner">
      <p class="pill">UK personal finance · Google Sheets</p>
      <h1>Simple Google Sheets for UK money</h1>
      <p class="lede">
        Calm guides and ready-made templates built for British salaries, tax years, and household bills —
        not US Excel worksheets with the wrong categories.
      </p>
      <div class="hero-actions">
        <a class="btn btn-on-dark" href={etsyUrl} rel="noopener noreferrer" target="_blank">Browse the Etsy shop</a>
        <a class="btn btn-ghost" href="/guides/">Read free guides</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <h2 class="section-title">Why Google Sheets</h2>
    <p class="section-intro">
      Most households here need a living file they can share and update on a phone — not a heavy desktop workbook.
      UkMoneySheets focuses on <strong>Google Sheets</strong> templates that speak UK: council tax, GBP, and tax years from 6 April.
    </p>

    <div class="features">
      <div class="feature">
        <h3>Built for Britain</h3>
        <p>Categories and tax-year thinking that match GOV.UK-style life, not 401(k) placeholders.</p>
      </div>
      <div class="feature">
        <h3>Google Sheets, not Excel</h3>
        <p>Browser-first files you can share with a partner and open on mobile without version chaos.</p>
      </div>
      <div class="feature">
        <h3>Guides first</h3>
        <p>Free explainers on budgeting, Self Assessment records, landlord tracking, and more — soft sell only.</p>
      </div>
    </div>

    <section style="margin-top: 2.75rem;" aria-labelledby="guides-heading">
      <h2 id="guides-heading" class="section-title">Latest guides</h2>
      <p class="section-intro">Practical overviews you can use whether or not you buy a template.</p>
      <div class="card-grid three">
        {
          guides.slice(0, 6).map((guide) => (
            <article class="card">
              <h3>
                <a href={`/guides/${guide.slug}/`}>{guide.data.title}</a>
              </h3>
              <p>{guide.data.description}</p>
              <a class="more" href={`/guides/${guide.slug}/`}>Read guide →</a>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 1.25rem;">
        <a href="/guides/">See all guides →</a>
      </p>
    </section>

    <SoftCta heading="Ready for a UK-ready sheet?" />
  </div>
</BaseLayout>
